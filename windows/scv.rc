#include <winver.h>
#include "tray-resources.h"
IDI_SCV_COLOR_LIGHT ICON "scv.ico"
IDI_SCV_COLOR_DARK ICON "scv-dark.ico"
IDI_SCV_MONO_LIGHT ICON "scv-mono.ico"
IDI_SCV_MONO_DARK ICON "scv-mono-dark.ico"
1 VERSIONINFO
