            VALUE "InternalName", "SocratiCodeV"
            VALUE "OriginalFilename", "SocratiCodeV.exe"
            VALUE "ProductName", "SocratiCode V"
            VALUE "ProductVersion", "0.1.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
